{
  "name": "isabele-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lambdas das tools do agente de pagamentos: listar_catalogo, registrar_intencao e realizar_compra",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:local": "docker run --rm -d -p 8000:8000 --name isabele-dynamodb-local amazon/dynamodb-local:latest -jar DynamoDBLocal.jar -inMemory",
    "db:local:parar": "docker stop isabele-dynamodb-local",
    "test": "DYNAMODB_ENDPOINT=http://localhost:8000 node --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/lib-dynamodb": "^3.1169.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
