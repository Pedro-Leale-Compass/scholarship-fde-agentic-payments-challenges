# Copie para .env (nunca commite o .env).
# Perfil e região usados pelo CDK e pelos scripts.
AWS_PROFILE=seu-perfil
AWS_REGION=us-east-1

# Modelo do Bedrock usado pelo agente (inference profile cross-region).
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Origens permitidas no CORS da API (separadas por vírgula).
# Enquanto o frontend roda local, use a porta do Vite.
ALLOWED_ORIGINS=http://localhost:5173

# Tempo de vida de uma intenção de compra, em segundos (Fase 1: 300).
INTENCAO_TTL_SEGUNDOS=300
