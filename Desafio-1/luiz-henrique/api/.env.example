# Variáveis de ambiente para desenvolvimento LOCAL contra o MiniStack
# Copie este arquivo para .env (nunca commite o .env com segredos reais).

# Endpoint do emulador AWS local (MiniStack Bedrock emulator + llm provider)
# Em produção (AWS real) deixe em branco / não defina -> usa o Bedrock real de us-east-1
BEDROCK_ENDPOINT_URL=http://localhost:4566

# Região AWS
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Credenciais fictícias do MiniStack (apenas local; não usar na AWS real)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ID do modelo usado no Bedrock emulator (proxyado para llama.cpp/Qwen3.5)
BEDROCK_MODEL_ID=qwen3.5

# Nome da tabela de usuários (prefixo luiz-henrique)
USUARIOS_TABLE=luiz-henrique-usuarios
