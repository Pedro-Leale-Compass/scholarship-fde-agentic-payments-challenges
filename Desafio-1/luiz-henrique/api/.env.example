# Variáveis de ambiente da Lambda do chat (AWS)
# Copie este arquivo para .env apenas se for testar a Lambda manualmente.

# Região AWS
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# ARN do AgentCore Runtime (definido pelo CDK no deploy)
AGENT_RUNTIME_ARN=

# Nome da tabela de usuários (prefixo luiz-henrique)
USUARIOS_TABLE=luiz-henrique-usuarios
