# Variáveis de ambiente — Desafio 1 (luiz-henrique)
# Copie este arquivo para .env (nunca commite o .env).

# Perfil AWS SSO usado no deploy e no desenvolvimento local (Bedrock real)
AWS_PROFILE=desafio-1

# Região
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Modelo Amazon Bedrock usado pelo agente (alvo do desafio: Claude Haiku 4.5).
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Fallback (Nova 2 Lite), caso o acesso ao Claude Haiku não esteja liberado na conta:
# BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Usuário de teste criado no Cognito pelo CDK (login do frontend)
TEST_EMAIL=<user email>
TEST_PASSWORD=<user password>
