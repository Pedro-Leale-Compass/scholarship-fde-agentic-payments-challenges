# Ambiente de desenvolvimento LOCAL contra o MiniStack (Docker)
# Copie este arquivo para .env (nunca commite o .env com segredos reais).

# Credenciais fictícias do MiniStack (apenas local; não usar na AWS real)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# Endpoints do MiniStack local (roda em :4566)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ENDPOINT_URL_S3=http://localhost:4566

# Profile que aponta o Lambda para o MiniStack (sem credenciais, só região)
AWS_PROFILE=local

# Para deploy na AWS real, use: AWS_PROFILE=desafio-1 (ou outro profile com SSO)
