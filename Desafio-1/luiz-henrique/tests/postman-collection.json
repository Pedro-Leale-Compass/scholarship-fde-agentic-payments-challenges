        {
          "name": "5.2 Tentar pagar com cartão (espera limite)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [{ \"text\": \"Pode pagar a intenção pendente com cartão.\" }]\n    }\n  ],\n  \"conversa_id\": \"{{conversaLimite}}\"\n}"
            },
            "url": {
              "raw": "{{apiUrl}}/chat",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "chat"
              ]
            },
            "description": "Tenta pagar a Cadeira Gamer com cartão; o saldo é insuficiente e a intenção é cancelada. Evidência 4: tentativa bloqueada por limite excedido."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('conversaLimite')) {",
                  "  throw new Error('Rode primeiro 5.1 Registrar intenção - Cadeira Gamer.');",
                  "}"
                ]
              }
            },
