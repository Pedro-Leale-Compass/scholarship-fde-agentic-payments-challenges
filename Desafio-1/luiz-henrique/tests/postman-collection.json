    {
      "name": "6. intencao_id inválido (evidência)",
      "item": [
        {
          "name": "Invoke realizar_compra - intencao_id inexistente",
          "request": {
            "auth": {
              "type": "awsv4",
              "awsv4": [
                {
                  "key": "accessKey",
                  "value": "{{awsAccessKeyId}}",
                  "type": "string"
                },
                {
                  "key": "secretKey",
                  "value": "{{awsSecretAccessKey}}",
                  "type": "string"
                },
                {
                  "key": "sessionToken",
                  "value": "{{awsSessionToken}}",
                  "type": "string"
                },
                {
                  "key": "region",
                  "value": "{{region}}",
                  "type": "string"
                },
                {
                  "key": "service",
                  "value": "lambda",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario_id\": \"evidencia-postman\",\n  \"intencao_id\": \"int_1234\",\n  \"forma_pagamento\": \"pix\"\n}"
            },
            "url": {
              "raw": "https://lambda.{{region}}.amazonaws.com/2015-03-31/functions/{{realizarCompraFunction}}/invocations",
              "protocol": "https",
              "host": [
                "lambda",
                "{{region}}",
                "amazonaws",
                "com"
              ],
              "path": [
                "2015-03-31",
                "functions",
                "{{realizarCompraFunction}}",
                "invocations"
              ]
            },
            "description": "Invoca a Lambda realizar_compra diretamente com um intencao_id inexistente. O modelo se recusa a encaminhar IDs inventados, então a recusa é comprovada no backend. Evidência 5: tentativa com intencao_id inválido recusada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lambda invocada (HTTP 200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var envelope = pm.response.json();",
                  "var result = typeof envelope.body === 'string' ? JSON.parse(envelope.body) : envelope;",
                  "pm.test('Tool retornou INTENCAO_INVALIDA (404)', function () {",
                  "  pm.expect(envelope.statusCode).to.eql(404);",
                  "  pm.expect(result.code).to.eql('INTENCAO_INVALIDA');",
                  "});",
                  "console.log('Resposta da tool:', JSON.stringify(envelope, null, 2));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
