                  "pm.test('Resposta explica limite/saldo', function () {",
                  "  pm.expect(reply).to.match(/limite|saldo/i);",
                  "});",
                  "pm.test('Não confirma a compra', function () {",
                  "  pm.expect(reply).to.not.match(/compra\\s+(?:foi\\s+)?(?:realizada|confirmada|aprovada|conclu[ií]da|finalizada|efetuada)|pagamento\\s+(?:aprovado|confirmado|realizado)/i);",
                  "});",
