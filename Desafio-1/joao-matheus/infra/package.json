{
  "name": "infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "synth": "cdk synth",
    "cdk": "cdk",
    "build:frontend": "npm --prefix ../frontend run build",
    "deploy": "npm run build:frontend && cdk deploy --require-approval never --outputs-file cdk-outputs.json",
    "usuario": "node scripts/criar-usuario.mjs",
    "agente": "node scripts/invocar-agente.mjs",
    "destroy": "node scripts/destroy.mjs"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1169.0",
    "@types/node": "^22.10.7",
    "@types/source-map-support": "^0.5.10",
    "aws-cdk": "^2.180.0",
    "esbuild": "^0.24.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  }
}
