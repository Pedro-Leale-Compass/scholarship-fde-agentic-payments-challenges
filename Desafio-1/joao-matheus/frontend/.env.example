# Exemplo de variáveis de ambiente para desenvolvimento local com Vite
# Preencha em .env.local caso deseje rodar o frontend localmente (npm run dev)
VITE_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/prod
VITE_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_REGION=us-east-1
