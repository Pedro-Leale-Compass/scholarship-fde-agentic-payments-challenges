{
  "name": "alvaro-agentic-payments-infra",
  "version": "0.1.0",
  "private": true,
  "description": "Infraestrutura como Código (AWS CDK v2 em TypeScript) - Desafio 1 (AWS Cloud)",
  "scripts": {
    "build": "tsc",
    "build:frontend": "npm --prefix ../frontend run build",
    "watch": "tsc -w",
    "cdk": "cdk",
    "synth": "cdk synth",
    "synth:backend-only": "cdk synth -c skipFrontendHost=true",
    "synth:with-cloudfront": "cdk synth -c skipFrontendHost=false",
    "deploy": "npm run build && cdk deploy --all --require-approval never --outputs-file cdk-outputs.json",
    "deploy:backend-only": "npm run deploy",
    "deploy:with-cloudfront": "npm run build:frontend && npm run build && cdk deploy --all -c skipFrontendHost=false --require-approval never --outputs-file cdk-outputs.json",
    "destroy": "cdk destroy --all --force",
    "destroy:backend-only": "npm run destroy",
    "destroy:with-cloudfront": "cdk destroy --all -c skipFrontendHost=false --force"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1169.0",
    "@aws-sdk/client-dynamodb": "^3.1168.0",
    "@aws-sdk/lib-dynamodb": "^3.1168.0",
    "@types/node": "^22.10.2",
    "aws-cdk": "^2.180.0",
    "esbuild": "^0.25.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.4.2"
  }
}
